# ---------- App ----------
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000          # public https URL in production (used in webhooks, links, map images)
DATABASE_URL=postgres://postgres@localhost:5432/wa_commerce
DATABASE_SSL=false                          # true when connecting to Render Postgres from outside Render
SESSION_SECRET=change-me
ENCRYPTION_KEY=                             # openssl rand -base64 32  (required in production, never change later)
RUN_WORKER_IN_PROCESS=true                  # true = one process runs web + jobs (cheapest); false = run `npm run worker` separately
ALLOW_SIGNUP=true
LOG_LEVEL=info
CRON_SECRET=                                # Vercel: protects /api/cron/tick (Vercel Cron sends it automatically)

# Seeded once on boot
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-please

# ---------- Shopify (only needed for the one-click "Install app" flow) ----------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-10

# ---------- Meta / WhatsApp Cloud API ----------
META_APP_ID=                                # needed to submit templates with image/document headers
META_APP_SECRET=                            # verifies webhook signatures
META_WEBHOOK_VERIFY_TOKEN=change-me
META_GRAPH_VERSION=v23.0

# ---------- AI (platform defaults; each store can add its own keys) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Google Maps Platform (Address Validation, Geocoding, Static Maps) ----------
GOOGLE_MAPS_API_KEY=

# ---------- Defaults for new stores ----------
DEFAULT_COUNTRY=PK
DEFAULT_TIMEZONE=Asia/Karachi
DEFAULT_CURRENCY=PKR
