{
  "name": "wa-commerce-automation",
  "version": "1.0.0",
  "description": "Multi-store WhatsApp automation for Shopify: order sync, confirmations, address verification, tracking, marketing, AI and owner reports",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node src/db/migrate.js",
    "dev": "node --watch src/server.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "dependencies": {
    "@vercel/functions": "^2.2.13",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "libphonenumber-js": "^1.11.17",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7"
  }
}
